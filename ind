	[ $UGL ]	&& printf "UGLE                   %4d\n" $UGL
	[ $PGL ]	&& printf "PGLUC                  %4d\n" $PGL
	[ $GLC ]	&& printf "GLC                    %4d\n" $GLC
	fi

if [ $VERBOSE ]; then
	[ $COMMON ] && ruled $OUTPWTH
				   printf "Dominical letter    %s\n" "$dominical"
				   printf "Epact               %s\n" "${EPACTS[$golden]}"
				   printf "Golden number       %s\n" "$golden"
				   printf "Julian delta        %d\n" $jdelta

	[ $equinox ] &&printf "Spring Equinox      %s\n" "${equinox:5}" |sed 's/-/\//'

	[ $_HC ]	&& printf "Passover            %s\n" $(hebcal -grh Ni 15 $(($hebconvert+$year-1))   |cut -f1) |sed 's/....-//;s/-/\//'
	[ $_HC ]	&& printf "Rosh Hashana %6s %s\n" "$shmita" $(hebcal -grh Ti 1 $(($hebconvert+$year)) |cut -f1) |sed 's/....-//;s/-/\//'
	[ $_HC ]	&& printf "Yom Kippur          %s\n" $(hebcal -grh Ti 10 $(($hebconvert+$year)) |cut -f1) |sed 's/....-//;s/-/\//'

				   printf "Lent                %s\n" $(date -d"$(ncal -e $year) -46 days" +%m/%d)
				   printf "Easter              %s\n" $(date -d"$(ncal -e $year)" +%m/%d)
				   printf "Advent              %s\n" $(date -d"11/$(ncal -h 11 $year |awk '/^Th/{print $NF}')+3 days" +%m/%d)

	[ $hijra ]	&& printf "Hijra               %s\n" "$hijra"

	[ "$jen" ]	&& printf "Japanese Era        %s\n" "${ERANAME[10#$ERANUM]}"
	[ "$cny" ]  && printf "Chinese New Year    %s %s\n" "${cny:5}" "$cny_full" |sed 's/-/\//'
	[ "$losz" ] && printf "Tibetan Losar       %s %s\n" "${tib_losar:5}" "$los_full" |sed 's/-/\//'

	[ $_PH ]	&& printf "Vassa               07/%02s\n" $(date -d"$(phases $year 7 2 |sed -n 1p) +1 day" +%d)
	[ $_PH ]	&& printf "Pavarana            10/%02s\n" $(date -d"$(phases $year 10 2 |sed -n 1p)" +%d)
	fi

